# vLLM profile for configured OpenAI-compatible endpoints.
# Copy to .env.vllm or load directly with uv --env-file.
# This file contains no secrets. If the endpoints require auth, add
# VLLM_API_KEY to your private .env or shell environment. OPENAI_API_KEY is
# intentionally not used for vLLM requests.

IPL_MODEL=vllm:google/gemma-4-31B-it
IPL_REASONING=none

IPL_FALLBACK_MODEL=vllm:openai/gpt-oss-120b

IPL_REVIEWER_ENABLED=true
IPL_REVIEWER_MODEL=vllm:openai/gpt-oss-120b
IPL_REVIEWER_REASONING=medium
IPL_REVIEWER_REEXTRACT_ENABLED=true

VLLM_GEMMA4_31B_BASE_URL=https://vllm.example.org/gemma-4-31B-it/v1
VLLM_GPT_OSS_120B_BASE_URL=https://vllm.example.org/gpt-oss-120b/v1
IPL_VLLM_LOCAL_ONLY_ALLOW_HOSTS=vllm.example.org

# Settings used for the example2 smoke/performance checks.
IPL_CHUNKING_SEMANTIC_TRIGGER_SENTENCE_COUNT=32
IPL_SUBAGENT_TIMEOUT_SECONDS=180
IPL_EXTRACTOR_MAX_SUBAGENT_CONCURRENCY=1
