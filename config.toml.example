[ipl]
db_path = ".finding_extractor.db"
redis_url = "redis://localhost:6379"
redis_result_ttl = 3600

default_model = "google-gla:gemini-3-flash-preview"
fallback_model = "openai:gpt-5.2"
# Common alternatives:
# - anthropic:claude-opus-4-6
# - google-gla:gemini-3.1-pro-preview
# - ollama:qwen3.6:35b-a3b-mlx-bf16
# - ollama:qwen3.6:35b-a3b-bf16
# - ollama:qwen3.6:35b-a3b-q8_0
# - ollama:gemma4:26b-mxfp8
# - ollama:medgemma:27b
# - ollama:gpt-oss:120b
# - ollama:gpt-oss:20b
# - vllm:google/gemma-4-31B-it
# - vllm:openai/gpt-oss-120b
reviewer_enabled = true
# reviewer_model = "openai-responses:gpt-5.4-mini"  # default
reviewer_reasoning = "low"
reviewer_reextract_enabled = true
extractor_max_subagent_concurrency = 5
default_reasoning = "medium"
allow_unknown_model_reasoning = false
batch_run_dir = ".batch_runs"
batch_workers = 4
batch_timeout_seconds = 420
batch_retries = 1
batch_status_interval_seconds = 5.0
batch_output_suffix = ".extracted.json"
batch_resume = true
update_model_list_interval_seconds = 172800
eval_run_dir = ".eval_runs"
eval_workers = 2
eval_timeout_seconds = 120
eval_retries = 0
eval_dataset_dir = "evals/datasets"
log_level = "WARNING"
log_json = false

# --- Local Ollama configuration ---
# For local Ollama extraction, uncomment and adjust these settings:
# default_model = "ollama:qwen3.6:35b-a3b-mlx-bf16"
# default_reasoning = "none"
# fallback_model = "ollama:gpt-oss:20b"
# reviewer_model = "ollama:qwen3.6:35b-a3b-bf16"
# reviewer_reasoning = "low"
# subagent_timeout_seconds = 300
# extractor_max_subagent_concurrency = 1
# allow_unknown_model_reasoning = true
# Note: also set OLLAMA_BASE_URL=http://localhost:11434/v1 in .env
# Note: set OLLAMA_MAX_LOADED_MODELS=4 in your environment for multi-model runs

# --- On-prem vLLM configuration ---
# The project includes defaults for two configured OpenAI-compatible vLLM
# deployments below. Override these for your served model endpoints.
# default_model = "vllm:google/gemma-4-31B-it"
# fallback_model = "vllm:openai/gpt-oss-120b"
# default_reasoning = "none"   # Gemma 4 does not expose a reasoning control
# reviewer_model = "vllm:openai/gpt-oss-120b"
# reviewer_reasoning = "medium"
# vllm_gemma4_31b_base_url = "https://vllm.example.org/gemma-4-31B-it/v1"
# vllm_gpt_oss_120b_base_url = "https://vllm.example.org/gpt-oss-120b/v1"
# vllm_local_only_allow_hosts = "vllm.example.org"
# If the service requires auth, set VLLM_API_KEY in .env, not config.toml.

# --- Local-only (PHI-safe) mode ---
# Set IPL_LOCAL_ONLY=true to force every path to approved local/on-prem
# inference only. Rejects cloud models, cloud-tagged Ollama models
# (:cloud / -cloud), non-loopback OLLAMA_BASE_URL, and unapproved vLLM hosts.
# See docs/configuration.md#local-only-mode.
# local_only_mode = false

logfire_enabled = false
logfire_send = "auto"
logfire_service_name = "finding-extractor"
logfire_environment = "dev"
logfire_capture_headers = false
logfire_system_metrics = false
logfire_instrument_provider_sdks = false
